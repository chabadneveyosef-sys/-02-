# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CHABAD_ERP_DEFAULT_LOCATION: ברירת מחדל למיקום לחישוב זמני שקיעה (למשל חיפה - נווה יוסף)
VITE_DEFAULT_LOCATION_NAME="חיפה - נווה יוסף"
VITE_DEFAULT_LAT="32.7840"
VITE_DEFAULT_LNG="35.0195"

# SECOND_ASSOCIATION_DEFAULT_FEE_PERCENT: אחוז עמלה ברירת מחדל לעמותה השנייה
VITE_SECOND_ASSOC_FEE_PERCENT="3"

